+def chrome_executable():
+    """An explicit Chrome/Chromium binary, or None to use Playwright's own.
+
+    Honours ``CHROME`` plus the other browser variables StudioKat exports
+    (``HYPERFRAMES_BROWSER_PATH``, ``REMOTION_BROWSER_EXECUTABLE``) so a
+    system/Nix-provided browser is used instead of downloading Playwright's.
+    """
+    for name in ("CHROME", "HYPERFRAMES_BROWSER_PATH", "REMOTION_BROWSER_EXECUTABLE"):
+        value = (os.environ.get(name) or "").strip()
+        if value and os.path.isfile(value):
+            return value
+    return None
+
