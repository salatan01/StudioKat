+// Silkscreen Poster · "A night-market poster".
+//
+// A lantern-lit night-market stall prints itself as a flat spot-ink screen
+// print: one ink layer per beat, one squeegee pull, one registration slip per
+// plate. Original StudioKat clip — the vendored silkscreen-poster demo (a
+// travel print) is technique reference only; its cities, copy and shots are
+// not reused. Deterministic: every value derives from `t`.
+
+import { clamp, seg, ss, hash } from '/core/lib.js';
+import {
+  makeTextures, ink, wipeRegion, wipeFront, squeegee,
+  paperSheet, inkFinish, polyPath, circlePath, rectPath,
+} from '/styles/silkscreen-poster/demo/engine/silk.js';
+import { pickInk } from '/styles/silkscreen-poster/demo/engine/poster.js';
+import { BLEED } from '/styles/silkscreen-poster/demo/engine/scenes.js';
+
+const canvas = document.getElementById('c');
+const ctx = canvas.getContext('2d');
+
+let META = {};
+try { META = await (await fetch('clip.json')).json(); } catch {}
+const W = (META.width | 0) || canvas.width;
+const H = (META.height | 0) || canvas.height;
+canvas.width = W;
+canvas.height = H;
+
+const DUR = Number(META.duration_seconds) || 6;
+window.DUR = DUR;
+
+// ---- inks: flat opaque spot colours, one plate each ----------------------
+const PAPER = '#EFE6D0';   // warm stock (paperSheet base; nothing prints on it)
+const SKY1  = '#1E2236';   // deep night sky
+const SKY2  = '#333852';   // night band above the stall
+const GROUND= '#12121A';   // dark street / counter
+const CANOPY= '#B4504A';   // terracotta awning
+const LANTERN= '#F5A623';  // warm lantern glow
+// headline ink chosen against the sky it prints on (real WCAG contrast)
+const HEAD = pickInk([SKY1], ['#E8E0C8', '#F3EAD8'], 4);
+
+// ---- layout (scales from W/H so any aspect renders) ----------------------
+const cx = W / 2;
+const B = BLEED;
+const horizon = H * 0.80;        // street line
+const headY = H * 0.16;          // headline baseline
+const lanternY = H * 0.34;       // main lantern centre
+
+// textures: seeded, deterministic, built once
+const T = makeTextures(PAPER, 7);
+
+// ---- headline ------------------------------------------------------------
+const HEADLINE = 'NIGHT MARKET';
+function headlineSize() {
+  let s = H * 0.125;
+  ctx.font = `900 ${Math.round(s)}px "Big Shoulders Display"`;
+  ctx.letterSpacing = '8px';
+  while (ctx.measureText(HEADLINE).width > W * 0.80 && s > 22) {
+    s -= 2;
+    ctx.font = `900 ${Math.round(s)}px "Big Shoulders Display"`;
+  }
+  return s;
+}
+function headBox() {
+  const size = headlineSize();
+  const w = ctx.measureText(HEADLINE).width;
+  return { size,
+    x0: cx - w / 2 - 30, x1: cx + w / 2 + 30,
+    y0: headY - size * 1.1, y1: headY + size * 0.25 };
+}
+
+// ---- paths (print units, full bleed) -------------------------------------
+const FULL = rectPath(-B, -B, W + 2 * B, H + 2 * B);
+const skyBand = rectPath(-B, H * 0.50, W + 2 * B, H * 0.22);
+const groundBand = rectPath(-B, horizon, W + 2 * B, H + B - horizon);
+const canopy = polyPath([
+  [-B, H + B],
+  [W * 0.12, horizon + 10],
+  [cx, H * 0.40],
+  [W * 0.88, horizon + 10],
+  [W + B, H + B],
+]);
+const mainLantern = circlePath(cx, lanternY, 92);
+const lanternStem = rectPath(cx - 10, lanternY + 92, 20, 30);
+const lanA = circlePath(W * 0.23, H * 0.54, 30);
+const lanB = circlePath(W * 0.81, H * 0.58, 24);
+
+// ---- timeline: one pull per beat -----------------------------------------
+const PULL_D = 0.85;
+const arrives = { ground: 0.50, subject: 1.40, headline: 2.30 };
+function prog(name, t) { return ss(seg(clamp(t, 0, DUR), arrives[name], arrives[name] + PULL_D)); }
+// registration slip: one fixed nudge per plate (deterministic, never animated)
+function reg(seed, amp) {
+  return [(hash(seed * 3.1 + 1) - 0.5) * 2 * amp, (hash(seed * 7.7 + 1.3) - 0.5) * 2 * amp];
+}
+
+// ---- camera: a slow push during the hold ---------------------------------
+function camera(t) {
+  const s = clamp(seg(t, arrives.headline + PULL_D, DUR));
+  const scale = 1 + 0.05 * ss(s);
+  return {
+    sx: scale, sy: scale,
+    tx: (1 - scale) * W / 2 + 12 * ss(s),
+    ty: (1 - scale) * H / 2,
+  };
+}
+
+// ---- drawing -------------------------------------------------------------
+function draw(t) {
+  const tt = clamp(t, 0, DUR);
+  ctx.setTransform(1, 0, 0, 1, 0, 0);
+  ctx.globalAlpha = 1;
+  ctx.globalCompositeOperation = 'source-over';
+  ctx.textBaseline = 'alphabetic';
+
+  const cam = camera(tt);
+  ctx.setTransform(cam.sx, 0, 0, cam.sy, cam.tx, cam.ty);
+
+  // stock (full bleed, always on)
+  paperSheet(ctx, T, -B, -B, W + 2 * B, H + 2 * B, 0.6);
+
+  // ---- pull 1: ground — night sky, band, street -----------------------
+  const g = prog('ground', tt);
+  if (g > 0) {
+    const clip = g < 1 ? wipeRegion([-B, -B, W + 2 * B, H + 2 * B], 'down', g, 1, 34) : null;
+    ink(ctx, { path: FULL },      { color: SKY1,   reg: reg(1, 2.2), clip, sheen: 0, trap: 0 });
+    ink(ctx, { path: skyBand },   { color: SKY2,   reg: reg(2, 2.2), clip, sheen: 0, trap: 0 });
+    ink(ctx, { path: groundBand },{ color: GROUND, reg: reg(3, 2.2), clip, sheen: 0, trap: 0 });
+  }
+
+  // ---- pull 2: subject — awning + lanterns ----------------------------
+  const s = prog('subject', tt);
+  if (s > 0) {
+    const subjectBox = [-B, H * 0.22, W + 2 * B, H + 2 * B];
+    const clip = s < 1 ? wipeRegion(subjectBox, 'down', s, 5, 30) : null;
+    ink(ctx, { path: canopy },       { color: CANOPY,   reg: reg(11, 2.2), clip, sheen: 0, trap: 0 });
+    ink(ctx, { path: mainLantern },  { color: LANTERN,  reg: reg(12, 2.2), clip, sheen: 0, trap: 0 });
+    ink(ctx, { path: lanternStem },  { color: GROUND,   reg: reg(13, 2.2), clip, sheen: 0, trap: 0 });
+    ink(ctx, { path: lanA },         { color: LANTERN,  reg: reg(14, 2.2), clip, sheen: 0, trap: 0 });
+    ink(ctx, { path: lanB },         { color: LANTERN,  reg: reg(15, 2.2), clip, sheen: 0, trap: 0 });
+    // signature squeegee pull — exactly once, tracking the leading edge
+    if (s < 1) {
+      const frontY = wipeFront(subjectBox, 'down', s, 30);
+      const pad = 220;
+      ctx.save();
+      squeegee(ctx,
+        [subjectBox[0] - pad, frontY],
+        [subjectBox[0] + subjectBox[2] + pad, frontY],
+        [0, 1],
+        { scale: 1, seed: 4, roll: tt * 1.6, handle: 0.55, bead: 30,
+          color: CANOPY, blade: '#23201E', wood: '#C48A52', shadow: 0.14 }
+      );
+      ctx.restore();
+    }
+  }
+
+  // ---- pull 3: headline — "NIGHT MARKET" into the sky ------------------
+  const h = prog('headline', tt);
+  if (h > 0) {
+    const hb = headBox();
+    const size = hb.size;
+    const box = [hb.x0, hb.y0, hb.x1 - hb.x0, hb.y1 - hb.y0];
+    const clip = h < 1 ? wipeRegion(box, 'right', h, 21, 24) : null;
+    ink(ctx, {
+      paint: (c) => {
+        c.font = `900 ${Math.round(size)}px "Big Shoulders Display"`;
+        c.letterSpacing = '8px';
+        c.textAlign = 'center';
+        c.textBaseline = 'alphabetic';
+        c.fillText(HEADLINE, cx, headY);
+      },
+    }, { color: HEAD, reg: reg(21, 1.6), clip, sheen: 0, trap: 0 });
+  }
+
+  // post-print finish: plate texture over the whole sheet
+  inkFinish(ctx, T, -B, -B, W + 2 * B, H + 2 * B, 0.6, 1);
+}
+
+window.render = t => draw(clamp(t, 0, DUR));
+
+// readable text: the headline (reported in full, even while the wipe reveals it)
+window.TEXTS = (t) => {
+  const tt = clamp(t, 0, DUR);
+  if (prog('headline', tt) <= 0) return [];
+  const hb = headBox();
+  return [{ id: 'headline', text: HEADLINE, x0: hb.x0, y0: hb.y0, x1: hb.x1, y1: hb.y1 }];
+};
+
+// fonts: every drawn face defined and loaded before READY
+try {
+  await Promise.all([
+    document.fonts.load('900 140px "Big Shoulders Display"', HEADLINE),
+  ]);
+} catch (e) {}
+await document.fonts.ready;
+
+draw(0);
+window.READY = true;
