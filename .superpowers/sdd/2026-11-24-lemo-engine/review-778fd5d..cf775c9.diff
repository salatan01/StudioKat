+      const yy=y+(1-k)*70, wC=measure('C',fs,800,SANS,-1), oR=fs*0.355; T('C',x,yy,{size:fs,weight:800,track:-1},'sig-c'); disc(x+wC+oR+2, yy-fs*0.355, oR, P.red); T('MPOUND',x+wC+2*oR+5,yy,{size:fs,weight:800,track:-1},'sig');
