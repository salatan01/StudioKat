+  r.rz = RZ ? Math.max(0, Math.min(RZ[2], r.x1) - Math.max(RZ[0], r.x0)) * Math.max(0, Math.min(RZ[3], r.y1) - Math.max(RZ[1], r.y0)) / ((RZ[2] - RZ[0]) * (RZ[3] - RZ[1])) : 0;
