@@ -0,0 +1,147 @@
+#!/bin/sh
+# Mux the finished film: mux.sh video.mp4 mix.wav out.mp4 [fps] [grain]
+# Video is output at the target frame rate (held segments get duplicated frames automatically); grain = grain strength (default 2, 0 = none; use 0 for pixel/vector styles)
+# Audio: two-pass loudnorm → −14 LUFS / TP −1.2 (a single pass is off by about 0.5 LU), then a 4× oversampled limiter at −1.6 dBFS (its look-ahead compensated), because AAC encoding adds
+#   inter-sample peaks loudnorm can't see. If the encoded film still peaks above −1 dBTP, the audio alone is encoded again with the limiter lower (the picture is copied, up to 3 times).
+#   Finally prints the measured I / LRA / true peak and warns if off target (loudness outside ±1 LU or peak above −1 dB)
+# (when the mix itself clips or has extremely high peaks, loudnorm's dynamic mode misses both targets; measured −20 LUFS / +5 dBTP)
+# A mix louder than 0 LUFS (badly clipped; loudnorm refuses it) is turned down to about −14 LUFS before normalising, with a warning.
+# Any failed ffmpeg step exits non-zero and leaves no half-written file; the output path is printed only if the finished file exists and is non-empty.
+#   (the film is written to a temporary file beside the output and renamed when complete, so Ctrl-C or a failed re-mux never touches an earlier good film)
+# Silent / extremely quiet audio (below −70 LUFS, which loudnorm can't measure): only when it "decoded successfully and measured as truly silent" is loudness normalisation skipped with a warning; the film is still made.
+# Not audio, no audio stream, or a damaged file: exit 1, no film. "Damaged" is judged from what actually decodes, not from seeing error wording:
+#   · the decoder reported an error (with damaged FLAC/MP3/M4A, ffmpeg often reports an error yet returns 0);
+#   · the decoded duration is clearly shorter than the container claims (truncated FLAC/MP3);
+#   · the WAV header declares more audio than the file actually holds (interrupted halfway through writing).
+#   A WAV streamed out by `ffmpeg … -f wav -` has a placeholder length in its header and decodes completely, but ends with three demuxer notices: that's a good file and the film is made as usual (with a one-line note).
+#   One case it can't detect: a streamed WAV truncated exactly on a sample boundary (no header length to compare, and decoding shows no error).
+# Audio shorter than the picture: padded with silence to the picture's length (the video is never cut short); audio longer: cut to the picture's length as before (-shortest).
+# Colour: by default exactly as before (keeps the yuvj420p full range / bt470bg tags that video.mjs outputs); LEMO_COLOR=bt709 switches to standard yuv420p limited range / bt709 (picture values differ by ±3 at most, but there's a slight colour difference from older films).
+# awk prints and reads decimals the way the locale says: under de_DE or fr_FR macOS awk writes 0,8318, and a comma splits an ffmpeg filter graph
+LC_ALL=C; export LC_ALL
+die() { echo "mux.sh: $*" >&2; exit 1; }
+V="$1"; A="$2"; O="$3"; FPS="${4:-24}"; GR="${5:-2}"
+[ -n "$V" ] && [ -n "$A" ] && [ -n "$O" ] || die "usage: sh core/render/mux.sh video.mp4 mix.wav out.mp4 [fps=24] [grain=2]"
+[ -f "$V" ] || die "video not found: $V"
+[ -f "$A" ] || die "audio not found: $A"
+case "$FPS" in ''|*[!0-9.]*) die "fps must be a number, got '$FPS'";; esac
+case "$GR" in ''|*[!0-9.]*) die "grain must be a number (0 = none), got '$GR'";; esac
+case "${LEMO_COLOR:-}" in ''|bt709) ;; *) die "LEMO_COLOR must be bt709 or unset, got '$LEMO_COLOR'";; esac
+# ffmpeg 7 or newer, as TECHNIQUE.md asks (older ones misreport the audio's length or reject the limiter's options with cryptic errors).
+# Only the newest ffmpeg is supported: an older one stops here with a clear message. A version that isn't a number (a git build) is let through
+command -v ffmpeg >/dev/null && command -v ffprobe >/dev/null || die "ffmpeg and ffprobe are needed (ffmpeg 7 or newer) and aren't on PATH"
+FFV=$(ffmpeg -version 2>/dev/null | sed -n '1s/^ffmpeg version n\{0,1\}\([0-9][0-9]*\)\..*/\1/p')
+[ -z "$FFV" ] || [ "$FFV" -ge 7 ] || die "needs ffmpeg 7 or newer, found $(ffmpeg -version 2>/dev/null | sed -n '1s/^ffmpeg version \([^ ]*\).*/\1/p'): update ffmpeg (Ubuntu 24.04 ships 6.1; use a static build such as https://johnvansickle.com/ffmpeg/)"
+
+# Check whether the audio length declared in the WAV header exceeds the file (for a WAV truncated on a sample boundary, ffmpeg itself reports no error). Reads the length byte by byte, independent of the machine's byte order
+wav_truncated() {   # returns 0 = the header declares more than the file holds; a placeholder length (0 or 0xFFFFFFFF) is treated as "length unknown", not truncated
+  [ "$(dd if="$1" bs=1 count=4 2>/dev/null)" = RIFF ] && [ "$(dd if="$1" bs=1 skip=8 count=4 2>/dev/null)" = WAVE ] || return 1
+  _size=$(wc -c < "$1" | tr -d ' '); _off=12
+  while [ $((_off + 8)) -le "$_size" ]; do
+    _id=$(dd if="$1" bs=1 skip=$_off count=4 2>/dev/null)
+    set -- "$1" $(od -An -tu1 -j $((_off + 4)) -N4 "$1"); _len=$(($2 + $3 * 256 + $4 * 65536 + $5 * 16777216))
+    if [ "$_id" = data ]; then
+      [ "$_len" -eq 0 ] || [ "$_len" -eq 4294967295 ] && return 1
+      [ $((_off + 8 + _len)) -gt "$_size" ] && return 0 || return 1
+    fi
+    _off=$((_off + 8 + _len + (_len & 1)))
+  done
+  return 1
+}
+
+# first pass: measure loudness
+[ -n "$(ffprobe -v error -select_streams a:0 -show_entries stream=codec_type -of csv=p=0 "$A" 2>/dev/null)" ] || die "no audio stream in '$A' (is it really the mixed audio file?)"
+M=$(ffmpeg -hide_banner -nostats -progress pipe:2 -i "$A" -af loudnorm=I=-14:TP=-1.2:LRA=11:print_format=json -f null - 2>&1) || die "ffmpeg cannot read the audio '$A': $(echo "$M" | tail -2)"
+wav_truncated "$A" && die "the WAV file '$A' is cut off: its header promises more audio than the file contains (was the write interrupted?)"
+# decoder/demuxer log lines all start with [name @ 0x…]; any with error wording, except the three fixed streamed-WAV notices below, mean the file is damaged (loudness would be -inf, but that isn't "silence")
+ERRS=$(echo "$M" | grep -E '^\[' | grep -iE 'error|invalid|corrupt|header missing|overread|truncat|incomplete')
+BENIGN='Ignoring maximum wav data size|Packet corrupt \(stream = [0-9]+, dts = NOPTS\)|corrupt input packet in stream [0-9]+'
+BAD=$(echo "$ERRS" | grep -vE "$BENIGN" | head -2)
+[ -z "$BAD" ] || die "the audio '$A' is damaged; ffmpeg reported while decoding it:
+$BAD"
+# seconds actually decoded (the last out_time from -progress) versus what the container claims; when the container duration is one ffmpeg "estimated from the bitrate" it's unreliable, so don't compare
+DEC=$(echo "$M" | grep '^out_time=' | tail -1 | cut -d= -f2 | awk '{ if ($0 ~ /^-/ || $0 !~ /:/) print 0; else { split($0, p, ":"); print p[1] * 3600 + p[2] * 60 + p[3] } }')
+CONT=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$A" 2>/dev/null | head -1)
+if ! echo "$M" | grep -q 'Estimating duration from bitrate' && awk -v d="${DEC:-0}" -v c="${CONT:-0}" 'BEGIN { tol = c * 0.05 > 0.15 ? c * 0.05 : 0.15; exit !(c + 0 > 0 && c - d > tol) }'; then
+  die "only ${DEC:-0} s of the ${CONT} s that '$A' claims could be decoded: the file is damaged or cut off"
+fi
+[ -z "$ERRS" ] || echo "mux.sh: note: ffmpeg complained about the header/ending of '$A' (typical of a WAV streamed with 'ffmpeg … -f wav -', whose length is a placeholder), but all ${DEC:-0} s decoded; continuing" >&2
+J=$(echo "$M" | sed -n '/{/,/}/p')
+g() { echo "$J" | grep "\"$1\"" | sed 's/.*: "\(.*\)".*/\1/'; }
+NORM=1
+for k in input_i input_tp input_lra input_thresh target_offset; do
+  case "$(g $k)" in ''|*inf*|*nan*) NORM=0;; esac
+done
+# loudnorm takes a measured loudness of 0 LUFS at most: a mix louder than that (badly clipped) is turned down to about -14 LUFS first and measured again.
+# Only such a mix gets the extra gain; every other mix goes through exactly the same filters as before
+PRE=""
+if [ "$NORM" = 1 ] && awk -v i="$(g input_i)" 'BEGIN { exit !(i + 0 > 0) }'; then
+  PG=$(awk -v i="$(g input_i)" 'BEGIN { printf "%.2f", i + 14 }'); PRE="volume=-${PG}dB,"
+  echo "mux.sh: warning: the mix measures $(g input_i) LUFS, louder than the 0 LUFS loudnorm accepts (it is almost certainly clipping); turning it down $PG dB before normalising. Lower the mix and mux again" >&2
+  M=$(ffmpeg -hide_banner -nostats -i "$A" -af "${PRE}loudnorm=I=-14:TP=-1.2:LRA=11:print_format=json" -f null - 2>&1) || die "ffmpeg cannot measure the turned-down audio '$A': $(echo "$M" | tail -2)"
+  J=$(echo "$M" | sed -n '/{/,/}/p')
+  for k in input_i input_tp input_lra input_thresh target_offset; do
+    case "$(g $k)" in ''|*inf*|*nan*) die "could not measure '$A' even turned down $PG dB";; esac
+  done
+fi
+if [ "$NORM" = 1 ]; then
+  LN="${PRE}loudnorm=I=-14:TP=-1.2:LRA=11:measured_I=$(g input_i):measured_TP=$(g input_tp):measured_LRA=$(g input_lra):measured_thresh=$(g input_thresh):offset=$(g target_offset):linear=true"
+else
+  LN="anull"
+  echo "mux.sh: warning: the audio is silent or quieter than -70 LUFS, so loudness normalisation was skipped" >&2
+fi
+
+# true-peak guard: the limiter ceiling in dBFS → its filter, run at 192 kHz so it sees the peaks between samples;
+# latency=1 takes back the limiter's 10 ms look-ahead, so the sound stays on the frames it was cut to
+CEIL=-1.6
+lim() { [ "$NORM" = 1 ] || return 0; echo ",aresample=192000,alimiter=limit=$(awk -v d="$1" 'BEGIN { printf "%.4f", 10 ^ (d / 20) }'):attack=10:release=200:level=disabled:latency=1"; }
+
+# pad with silence if the audio is shorter than the picture
+dur() { ffprobe -v error -show_entries format=duration -of csv=p=0 "$1" 2>/dev/null | head -1; }
+VD=$(dur "$V"); AD=$(dur "$A"); PAD=""
+if awk -v a="$AD" -v v="$VD" 'BEGIN { exit !(a + 0 > 0 && v + 0 > 0 && a + 0 < v - 0.02) }'; then
+  PAD=",apad=whole_dur=$VD"
+  echo "mux.sh: note: the audio ($AD s) is shorter than the video ($VD s); padding it with silence" >&2
+fi
+
+if [ "$GR" = "0" ]; then VF="fps=$FPS"; else VF="fps=$FPS,noise=c0s=$GR:allf=t"; fi
+if [ "${LEMO_COLOR:-}" = "bt709" ]; then
+  VF="$VF,scale=in_range=pc:out_range=tv:out_color_matrix=bt709,format=yuv420p,setparams=range=tv:colorspace=bt709:color_primaries=bt709:color_trc=bt709"
+  CARGS="-color_range tv -colorspace bt709 -color_primaries bt709 -color_trc bt709"
+else
+  VF="$VF,format=yuv420p"; CARGS=""
+fi
+# the temporary file keeps the output's extension, since ffmpeg picks the container from it
+B=${O##*/}; case "$B" in *.*) EXT=${B##*.} ;; *) EXT=mp4 ;; esac
+TMP="$O.$$.part.$EXT"
+trap 'rm -f "$TMP"' EXIT
+trap 'exit 130' INT; trap 'exit 143' TERM
+# shellcheck disable=SC2086  (CARGS must split on spaces into several arguments; empty by default)
+ffmpeg -y -loglevel error -i "$V" -i "$A" \
+  -filter_complex "[0:v]$VF[v];[1:a]$LN$(lim $CEIL),aresample=48000$PAD[a]" \
+  -map "[v]" -map "[a]" -c:v libx264 -preset slow -crf 19 -r "$FPS" $CARGS -c:a aac -b:a 256k -movflags +faststart -shortest "$TMP" \
+  || die "ffmpeg failed while writing '$O' (its message is above)"
+[ -s "$TMP" ] || die "no output was written to '$O'"
+mv -f "$TMP" "$O" || die "could not move the finished film to '$O'"
+echo "$O"
+measure() { ffmpeg -hide_banner -nostats -i "$O" -vn -af ebur128=peak=true -f null - 2>&1 | grep -E "^\s+(I|LRA|Peak):" | head -3; }
+R=$(measure); N=0
+while [ "$NORM" = 1 ] && [ $N -lt 3 ]; do
+  OP=$(echo "$R" | awk '$1 == "Peak:" { print $2 }')
+  [ -n "$OP" ] || break                       # no measurement: don't re-encode blind
+  awk -v p="$OP" 'BEGIN { exit !(p + 0 > -1) }' || break
+  CEIL=$(awk -v c="$CEIL" -v p="$OP" 'BEGIN { printf "%.2f", c - (p + 1.3) }'); N=$((N + 1))
+  echo "mux.sh: note: true peak $OP dB after encoding; encoding the audio again with the limiter at $CEIL dBFS (picture copied)" >&2
+  ffmpeg -y -loglevel error -i "$O" -i "$A" -filter_complex "[1:a]$LN$(lim $CEIL),aresample=48000$PAD[a]" \
+    -map 0:v -map "[a]" -c:v copy -c:a aac -b:a 256k -movflags +faststart -shortest "$TMP" \
+    || die "ffmpeg failed while encoding the audio of '$O' again (its message is above)"
+  [ -s "$TMP" ] && mv -f "$TMP" "$O" || die "could not replace '$O' with the re-encoded film"
+  R=$(measure)
+done
+echo "$R"
+if [ "$NORM" = 1 ]; then
+  OI=$(echo "$R" | awk '$1 == "I:" { print $2 }'); OP=$(echo "$R" | awk '$1 == "Peak:" { print $2 }')
+  awk -v i="$OI" -v p="$OP" 'BEGIN { exit !(i + 0 < -15 || i + 0 > -13 || p + 0 > -1) }' \
+    && echo "mux.sh: warning: the film missed the target (-14 LUFS, true peak <= -1 dB): measured $OI LUFS, peak $OP dB. The mix is probably clipping or has very hot peaks: lower it and tame the peaks, then mux again" >&2
+fi
+exit 0
diff --git a/.agents/skills/lemo/library/core/render/page.mjs b/.agents/skills/lemo/library/core/render/page.mjs
new file mode 100644
index 0000000..2cd4e40
--- /dev/null
+++ b/.agents/skills/lemo/library/core/render/page.mjs
@@ -0,0 +1,107 @@
+// Open a demo page (the repo root is the static server root; film projects outside the library are mounted under /@film/) and wait for window.READY
+// Fail loudly: a JS error in the page, or a failed load of a script (<script>, module import; resourceType script) or of the page itself (document), exits immediately (non-zero).
+// Other types (fetch / xhr / images / fonts…) only print a one-line warning on 404: many demos fetch an optional voices/dur.json and use defaults when it's missing
+import { chromium } from 'playwright-core';
+import fs from 'fs'; import path from 'path'; import { fileURLToPath } from 'url';
+import { serve, pageURL } from './serve.mjs';
+import { createRequire } from 'module';
+import { EXE, ARGS, warnIfSoftwareGL, WATCH_GL_LOST, GL_LOST_HELP, glLost } from './browser.mjs';
+export { GL_LOST_HELP, glLost };
+export const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..');
+let srv = null;
+export async function server() { if (!srv) srv = await serve(ROOT); return srv; }
+// every entry script calls this before creating any output directory
+export function requireDemo(dir) {
+  if (!dir || dir.startsWith('--')) { console.error('usage: <demo> is the folder that holds index.html (see core/README.md)'); process.exit(2); }
+  if (!fs.existsSync(path.join(dir, 'index.html'))) { console.error(`no index.html in "${dir}": the demo folder is wrong or the page isn't there yet`); process.exit(2); }
+}
+// --size WxH (default 1920x1080): removes the pair from args and returns { w, h }. Width and height must be even (an H.264 yuv420p requirement), 16–8192
+export function takeSize(args) {
+  const i = args.indexOf('--size'); if (i < 0) return { w: 1920, h: 1080 };
+  const v = args.splice(i, 2)[1] || '', m = /^(\d+)x(\d+)$/.exec(v), w = m && +m[1], h = m && +m[2];
+  if (!m || [w, h].some(n => n < 16 || n > 8192 || n % 2)) { console.error(`bad --size "${v}": use WxH with even numbers from 16 to 8192, e.g. 1080x1920`); process.exit(2); }
+  return { w, h };
+}
+const warned = new Set();   // each optional file warns only once per process (video.mjs opens several pages)
+const FATAL = new Set(['script', 'document']);   // things the page must have; module imports also have type script
+// A fatal error closes the browsers before exiting: on Linux (WSL among them) a killed browser's helper processes can outlive it
+// and keep the caller's stdout/stderr open, so whoever reads the tool's output would wait forever. Every browser this process
+// opened (video.mjs opens several), at most 5 s for the close; calls still running on the pages fail quietly meanwhile.
+let quitting = false;
+const browsers = new Set();
+async function quit() {
+  if (quitting) return new Promise(() => {}); quitting = true;
+  process.on('unhandledRejection', () => {}); process.on('uncaughtException', () => {});
+  await Promise.race([Promise.all([...browsers].map(b => b.close().catch(() => {}))), new Promise(r => setTimeout(r, 5000))]);
+  closeServer(); process.exit(1);
+}
+// gl: check for a lost WebGL context before handing the page over (the tools that only read the page, readcheck and events, pass false)
+export async function openDemo(dir, { w = 1920, h = 1080, q = '', warnings = false, gl = true } = {}) {
+  requireDemo(dir);
+  const { port } = await server();
+  let browser;
+  try { browser = await chromium.launch({ executablePath: EXE, args: ARGS }); }
+  catch (e) {   // playwright's own advice (npx playwright install) fetches the browser of another playwright version
+    if (!EXE && /Executable doesn't exist|playwright install/i.test(String(e.message))) {
+      const v = createRequire(import.meta.url)('playwright-core/package.json').version;
+      console.error(`the headless browser for playwright-core ${v} is not installed. From the library root run\n` +
+        `  sh plugin/skills/lemo-opuscar/scripts/setup.sh deps\n  (or: node node_modules/playwright-core/cli.js install chromium-headless-shell; not npx playwright install,\n` +
+        `  which installs the browser of another playwright version). Or point PLAYWRIGHT_CHROME at a chrome-headless-shell.`);
+      process.exit(1);
+    }
+    throw e;
+  }
+  browsers.add(browser);
+  const page = await browser.newPage({ viewport: { width: w, height: h }, deviceScaleFactor: 1 });
+  await page.addInitScript(WATCH_GL_LOST);
+  const log = [];   // recent errors, printed together if READY is slow to arrive
+  const note = s => { log.push(s); if (log.length > 8) log.shift(); console.error(s); };
+  page.on('console', m => {
+    const t = m.text();
+    if (m.type() === 'error' && /^Failed to load resource/.test(t)) return;   // printed with its URL by the response event below
+    if (m.type() === 'error' || (warnings && m.type() === 'warning') || /too many active webgl contexts/i.test(t)) note('[page] ' + t.slice(0, 300));
+  });
+  const fontsMissing = [];   // a page that loads its faces itself (document.fonts.load, new FontFace) rejects with a bare "network error"
+  page.on('pageerror', e => {   // stop on an error during rendering, so no broken film is produced
+    console.error('[pageerror]', e.message);
+    if (fontsMissing.length && /network error/i.test(e.message)) console.error(`  that is the missing font file${fontsMissing.length > 1 ? 's' : ''} above (${fontsMissing.join(', ')})`);
+    quit();
+  });
+  page.on('response', r => {
+    if (r.status() < 400) return;
+    const u = r.url(), p = new URL(u).pathname, type = r.request().resourceType();
+    if (p === '/favicon.ico') return;
+    if (FATAL.has(type)) {
+      if (quitting) return;
+      note(`[page] ${r.status()} ${u}`);
+      console.error(`the page needs ${p} (a ${type}) but the server answered ${r.status()}. Check the path: pages use absolute URLs like /core/lib.js (see core/README.md)`); quit(); return;
+    }
+    if (warned.has(u)) return; warned.add(u);
+    if (type === 'font') {   // the text would come out in another face: say which file, and where fonts come from
+      fontsMissing.push(p);
+      let shown = p; try { shown = decodeURIComponent(p); } catch {}   // a bare % in a file name
+      note(`[page] font file missing: ${shown} (${r.status()}). Fonts are not kept in git: a library demo's build.sh fetches them ` +
+        `(its CREDITS names each face); in your own page, put the file there or correct the @font-face url`);
+    } else note(`[page] optional file missing: ${u} (${r.status()}, requested by ${type === 'fetch' || type === 'xhr' ? 'fetch/xhr' : type}; fine if the page has a fallback)`);
+  });
+  page.on('requestfailed', r => { if (!/favicon/.test(r.url()) && r.failure()?.errorText !== 'net::ERR_ABORTED') note(`[page] request failed ${r.url()} (${r.failure()?.errorText})`); });
+  try { await page.goto(pageURL(ROOT, port, dir) + (q ? '?' + q : '')); }
+  catch (e) { if (quitting) await quit(); console.error(`the page didn't load: ${e.message.split('\n')[0]}`); await quit(); }
+  const hint = setTimeout(() => {
+    console.error(`still waiting for window.READY after 20 s. The page has to set window.READY = true once fonts and images are loaded.\n` +
+      (log.length ? '  problems seen so far:\n    ' + log.join('\n    ') + '\n' : '  no console errors so far: is the <script> closed, does it reach the line that sets window.READY?\n') +
+      `  debug: node core/render/still.mjs ${dir} 0, or open the page in a normal browser (the tools serve the library root on 127.0.0.1)`);
+  }, 20000);
+  const t0 = Date.now();
+  try { await page.waitForFunction(() => window.READY === true, null, { timeout: 180000 }); }
+  catch (e) { if (quitting) await quit(); console.error(`window.READY never became true (waited ${((Date.now() - t0) / 1000).toFixed(0)} s, limit 180 s): ${e.message.split('\n')[0]}`); await quit(); }
+  finally { clearTimeout(hint); }
+  const lost = gl && await glLost(page);   // a blank film is worse than a failed render
+  if (lost) {
+    console.error(`the WebGL context (${lost}) was lost before the first frame: ${GL_LOST_HELP}`);
+    await quit();
+  }
+  await warnIfSoftwareGL(page);
+  return { browser, page };
+}
+export function closeServer() { if (srv) srv.server.close(); }
diff --git a/.agents/skills/lemo/library/core/render/readcheck.mjs b/.agents/skills/lemo/library/core/render/readcheck.mjs
new file mode 100644
index 0000000..10254f9
--- /dev/null
+++ b/.agents/skills/lemo/library/core/render/readcheck.mjs
@@ -0,0 +1,55 @@
+// Reading-time self-check: node core/render/readcheck.mjs <demo> [--q 'k=v'] [--step 0.04] [--latin-cps 15] [--cjk-cps 4.5] [--pad 1.5] [--min 1.5] [--size 1920x1080]
+// Page contract: window.TEXTS(t) → [{id, text, x0, y0, x1, y1}]: every piece of text visible on screen at t seconds and its screen box (pixels, viewport the same as --size, default 1920×1080).
+//   id identifies "this block of text" (a number or a string); if the text under the same id changes, it counts as a new piece and timing restarts. Don't report the subtitle bar: its hold is set by the .srt.
+//   text must be the block's [complete text] from the first frame it appears: if a typewriter effect reports "the substring typed so far", every extra character is a new piece and the whole check fails —
+//   for typewriter text, always report the full text in TEXTS and leave "which characters are shown yet" to the picture itself.
+// Rule (same as DIRECTOR.md §7): from the moment a piece of text first fully enters the frame, the time it stays fully in frame continuously, and still in TEXTS, must be ≥
+//   (number of hanzi/kana/hangul ÷ cjk-cps + number of other non-whitespace characters ÷ latin-cps) + pad seconds, and no less than min. Defaults 4.5 chars/s (CJK), 15 chars/s (alphanumeric), pad 1.5, min 1.5.
+//   Text that never fully enters the frame (cropped at the edge, a ticker running out of frame) is reported as "never fully visible".
+//   Text the viewer isn't meant to read in full (a shop sign in a fly-through, a label the camera sweeps past, the fine-print licence credits
+//   on an end card) can carry pass: true: it is listed as passing and not timed. Anything the film needs the viewer to read must not be marked.
+// Exit code: 0 all pass; 1 some fail; 2 the check couldn't run (the page has no window.TEXTS, or the whole film never returned any text) — this does not count as a pass.
+import { openDemo, closeServer, requireDemo, takeSize } from './page.mjs';
+const args = process.argv.slice(2), { w: VW, h: VH } = takeSize(args), opt = (k, d) => { const i = args.indexOf(k); return i >= 0 ? args[i + 1] : d; };
+const dir = args[0]; requireDemo(dir);
+const Q = opt('--q', ''), STEP = +opt('--step', 0.04), LATIN = +opt('--latin-cps', 15), CJK = +opt('--cjk-cps', 4.5), PAD = +opt('--pad', 1.5), MIN = +opt('--min', 1.5);
+if (![STEP, LATIN, CJK, PAD, MIN].every(Number.isFinite) || STEP <= 0 || LATIN <= 0 || CJK <= 0) { console.error('bad option value (step and the cps values must be > 0)'); process.exit(2); }
+const { browser, page } = await openDemo(dir, { w: VW, h: VH, q: Q, gl: false });   // reads text boxes, draws nothing
+const res = await page.evaluate(({ STEP }) => {
+  if (typeof window.TEXTS !== 'function') return { noTexts: true };
+  if (!(window.DUR > 0)) return { noDur: true };
+  const W = innerWidth, H = innerHeight, seen = {}, partial = {}, passing = {};
+  for (let t = 0; t <= window.DUR; t += STEP) {
+    window.render(t);
+    const vis = new Set();
+    for (const b of window.TEXTS(t) || []) {
+      b.id = String(b.id);   // numeric ids are fine too
+      const key = b.id + '\u0000' + b.text;   // text changed under the same id = a new piece
+      if (b.pass) { passing[key] ??= { id: b.id, text: b.text, t0: t }; continue; }   // only passed, not read: listed, not timed
+      if (!(b.x0 >= 0 && b.y0 >= 0 && b.x1 <= W && b.y1 <= H)) { partial[key] ??= { id: b.id, text: b.text, t0: t }; continue; }
+      vis.add(key);
+      const s = seen[key] ??= { id: b.id, text: b.text, t0: t, run: 0, done: false };
+      if (!s.done) s.run = Math.min(t + STEP, window.DUR) - s.t0;
+    }
+    for (const k in seen) if (!vis.has(k)) seen[k].done = true;   // only the first continuous on-screen stretch counts
+  }
+  for (const k in partial) if (seen[k]) delete partial[k];
+  return { seen: Object.values(seen), partial: Object.values(partial), passing: Object.values(passing) };
+}, { STEP });
+await browser.close(); closeServer();
+
+if (res.noTexts || res.noDur || (!res.seen.length && !res.partial.length && !res.passing.length)) {
+  console.error('readcheck: NOT CHECKED — ' + (res.noTexts ? 'the page has no window.TEXTS(t) (see the header of core/render/readcheck.mjs for the contract).'
+    : res.noDur ? 'window.DUR is not a positive number.' : 'window.TEXTS(t) never returned any text over the whole film.') + ' This is not a pass.');
+  process.exit(2);
+}
+const isCJK = ch => /[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}\p{Script=Hangul}]/u.test(ch);
+const need = text => { let cjk = 0, other = 0; for (const ch of text) { if (/\s/.test(ch)) continue; isCJK(ch) ? cjk++ : other++; } return Math.max(MIN, cjk / CJK + other / LATIN + PAD); };
+let bad = 0;
+for (const s of res.seen) {
+  const n = need(s.text), ok = s.run >= n - 1e-6; if (!ok) bad++;
+  console.log(`${ok ? 'OK ' : 'BAD'} ${s.id.padEnd(18)} at ${s.t0.toFixed(2)}s  ${String([...s.text].filter(c => !/\s/.test(c)).length).padStart(3)} chars  need ${n.toFixed(2)}s  got ${s.run.toFixed(2)}s  ${JSON.stringify(s.text.slice(0, 24))}`);
+}
+for (const s of res.partial) { bad++; console.log(`BAD ${s.id.padEnd(18)} at ${s.t0.toFixed(2)}s  never fully visible (its box is outside the frame)  ${JSON.stringify(s.text.slice(0, 24))}`); }
+for (const s of res.passing) console.log(`--  ${s.id.padEnd(18)} at ${s.t0.toFixed(2)}s  passing (pass: true), not timed  ${JSON.stringify(s.text.slice(0, 24))}`);
+process.exit(bad ? 1 : 0);
