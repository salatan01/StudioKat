+  for (let i = 0; i < N; i++) {
+    const it = list[i];
+    const pi = p >= 1 ? 1 : (p - i / N * .8) / .25;
+    if (pi <= 0) continue;
+    if (it.s) draw(L, it.s, pi, am);
