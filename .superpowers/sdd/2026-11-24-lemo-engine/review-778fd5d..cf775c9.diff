+tt = np.arange(N) / SR
+mask = np.ones(N)
+def cos_fade(a, b):  # falls from 1 to 0 over a→b
+    s = (tt >= a) & (tt < b); mask[s] *= .5 + .5 * np.cos(np.pi * (tt[s] - a) / (b - a))
