+const TRAV0 = 20360, TRAV1 = 39630, FAR = 19270;
+
+export const SHOTS = [
+  { n: 1, t0: 0, t1: bt(2) }, { n: 2, t0: bt(2), t1: bt(3, 1) }, { n: 3, t0: bt(3, 1), t1: 10 },
+  { n: 4, t0: 10, t1: PAR.swap[0] }, { n: 5, t0: PAR.swap[0], t1: BA.swap[0] }, { n: 6, t0: BA.swap[0], t1: PUSH.t0 },
