+
+// ---------- One frame ----------
+function world(t, cam) {
+  ZL = cam.z;
+  KS = cam.z < 1 ? Math.pow(cam.z, -0.6) : Math.pow(cam.z, -0.75);
+  const m = 200 / cam.z;
