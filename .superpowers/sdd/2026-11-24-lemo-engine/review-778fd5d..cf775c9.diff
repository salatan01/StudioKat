+CLIMAX += [(2, 0.0, 'G6', .5, 1), (2, 0.5, 'E6', .5, 0), (2, 1.0, 'C6', 1.0, 0), (2, 2.5, 'F#6', .5, 0), (2, 3.0, 'A6', 1.0, 0)]
