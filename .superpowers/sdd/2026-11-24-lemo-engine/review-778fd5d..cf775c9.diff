@@ -0,0 +1,57 @@
+#!/bin/sh
+# One command: 《七十二个座位》 Seventy-Two Seats (Isometric People Scene demo)
+#   sh styles/isometric-picture-book/demo/build.sh        Chinese narration (the library film): isometric-picture-book.mp4
