+  g.setTransform(1,0,0,1,0,0);
+  if (fallK>=1) rect(0,0,W,H,P.paper);
+  const c=CAM4b, scr = (x,y)=>[W/2+c.s*(x-c.x), H/2+c.s*(y-c.y)];
+  const L4 = S4lines();
