+  g.save(); g.translate(f[0], f[1]); g.scale(1, .2); D.glow(g, 0, 0, s * 40, '#000000', .7); g.restore();
+  CH.drawFigure(g, { x: f[0], y: f[1] - CH.PIP_SOLE * s, s, ...P });
+}
+
+export function streetShot(g, t) {
