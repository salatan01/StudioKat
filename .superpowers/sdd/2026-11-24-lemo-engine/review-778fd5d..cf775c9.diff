+  else if (face === 'focus') { ink(ctx, [[x - 12, y], [x + 8, y - 2]], 3.4, { seed: 97 }); shape(ctx, ellipse(x + 8, y + 4, 5.5, 4.5, 10), { fill: PAL.coralL, line: 2.4, seed: 98, grain: 0, breaks: 0 }); }
