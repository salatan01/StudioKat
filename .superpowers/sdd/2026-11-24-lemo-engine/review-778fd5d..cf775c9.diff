+
+# 9–11. Climax chord section:37.2 Bbmaj7 → 39.6 F/A → 42.0 Gm9 → 44.4 Ebmaj7 → 46.8 A7sus4 → 49.2 A7
+CH = [
+    (37.2, 39.6, ['Bb2', 'D3', 'F3', 'A3'], ['Bb2', 'D3', 'F3', 'A3', 'Bb3', 'D4', 'F4', 'A4', 'D5'], 'Bb1'),
