+const flagsets = { default: [], metal: ['--use-angle=metal', '--enable-gpu', '--ignore-gpu-blocklist'], gl: ['--use-angle=gl', '--enable-gpu', '--ignore-gpu-blocklist'] };
+for (const [name, fl] of Object.entries(flagsets)) {
