+    x = np.stack([ladder(x[:, 0], fc, .35, SR), ladder(x[:, 1], fc, .35, SR)], 1)
+    env = np.clip(t / 2.0, 0, 1) ** 2
+    place(stems['drone'], x * env[:, None] * .38, t0)
+    cues['drone'] = t0
