+}
+
+function eye(ctx, x, y, face, blink, i, sx = 1) {
+  if (face === 'happy' || blink > 0.5 || (face === 'wink' && i === 0)) {
+    const up = face === 'happy' || face === 'wink';
+    ink(ctx, up ? [[x - 8 * sx, y + 3], [x, y - 5], [x + 8 * sx, y + 3]] : [[x - 8 * sx, y], [x + 8 * sx, y]], 4, { seed: 80 + i, taper: false });
+  } else {
