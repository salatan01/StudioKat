+    const lift = ss(seg(p, .55, 1)) * 42 * deg;                 // late stance: heel lifts, rotating about the toe
+    T = [toeX, Hcur - 5];
+    A = [T[0] + Math.cos(lift) * FOOT, T[1] - 13 - Math.sin(lift) * FOOT];
+  } else {
+    const u = (pl - duty) / (1 - duty), sw = (1 - duty) * P;
