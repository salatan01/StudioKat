+  }
+  jrep.push(`${name.padEnd(11)} ${J.t0.toFixed(2)}–${J.t1.toFixed(2)} s  hold ${(J.t1 - J.t0).toFixed(2)} s  frame ${(1920 / J.z).toFixed(0)} board px wide  min margin ${worst.toFixed(0)} px  max speed ${vmax.toFixed(1)} px/frame`);
