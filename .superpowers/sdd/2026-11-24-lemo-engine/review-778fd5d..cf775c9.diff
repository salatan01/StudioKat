+  ink(ctx, [[120, FY - 4], [1820, FY - 6]], 4, { breaks: 0.35, seed: 5, taper: true });
+  const sb = back(seg(u, 3 * BEAT - 0.05, 3 * BEAT + 0.32), 1.6);
+  if (sb > 0) {
