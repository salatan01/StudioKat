+  const drumV = { x: T2W(860, 0)[0], y: T2W(0, 10)[1], z: 1.2 };
+  if (t < K.tilt[1]) { const u = eio(seg(t, K.tilt[0], K.tilt[1])); return { x: lerp(mouth.x, drumV.x, u), y: lerp(mouth.y, drumV.y, u), z: Math.exp(lerp(Math.log(1.75), Math.log(1.2), u)) }; }
