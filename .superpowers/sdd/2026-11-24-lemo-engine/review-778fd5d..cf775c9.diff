+
+# 3. Square-wave 16th-note sequence 7.2–16.2 (a Carpenter-style ostinato), filter opening slowly, rising sweep 10.35–11.4
+SEQ = ['D3', 'A3', 'F3', 'A3', 'D4', 'A3', 'F3', 'A3']
+def seq():
+    t = 7.2; k = 0
