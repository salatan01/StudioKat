+  {
+    const c = P(0, 100, Z0), s = cam.scaleAt(0, 100, Z0);
+    if (c[2] > 1) D.sunburst(g, c[0], c[1], { rays: 22, r0: s * 2, r1: s * 8.4, a0: Math.PI, a1: D.TAU, mode: 'lines', w: 1.6, alpha: .8 });
