index 0000000..221de3c
--- /dev/null
+++ b/.agents/skills/lemo/library/styles/ink-wash/demo/frames.js
@@ -0,0 +1,68 @@
+// Style frames (?test=frame&f=wide|cross|cut)
+import { mk, draw, blot, TONE } from './ink.js';
+import { hero, POSE } from './hero.js';
+import { wave } from './wave.js';
+import { shuiStrokes, cutStroke } from './glyph.js';
+import { mulberry } from '/core/lib.js';
+import { subtitle } from './subs.js';
+let TMP = null;
+function tmp() { if (!TMP) { const m = () => { const c = document.createElement('canvas'); c.width = 1920; c.height = 1080; return c; }; TMP = { wet: m(), dry: m(), col: m() }; TMP.ink = { wet: TMP.wet.getContext('2d'), dry: TMP.dry.getContext('2d'), col: TMP.col.getContext('2d') }; } for (const k of ['wet', 'dry', 'col']) { const c = TMP.ink[k]; c.setTransform(1, 0, 0, 1, 0, 0); c.clearRect(0, 0, 1920, 1080); } return TMP; }
+import { ridgeFn, mountainLayer, cun, cliff, pine, reed, ripple } from './land.js';
+export function renderFrame(t, A, comp, f) {
+  A.clear(); const L = A.ink;
+  if (f === 'wide') {
+    const far = ridgeFn([[1480, 330, 90], [1690, 250, 110], [1270, 200, 80], [380, 150, 110], [120, 200, 90], [760, 100, 120], [980, 60, 90]], 560, 3, 30);
+    const midR0 = ridgeFn([[1650, 420, 80], [1860, 310, 90], [1420, 230, 90], [1250, 120, 70]], 700, 7, 34), midR = midR0;
+    const bank0 = ridgeFn([[180, 85, 110], [470, 55, 100], [-40, 70, 80]], 705, 11, 14), bank = bank0;
+    A.cw.drawImage(mountainLayer({ W: 1920, H: 1080, ridge: far, depth: 230, tone: .16, rim: .55, rimW: 24, mist: .9, seed: 3 }), 0, 0);
+    A.cw.drawImage(mountainLayer({ W: 1920, H: 1080, ridge: midR, xmask: x => Math.min(1, Math.max(0, (x - 1130) / 160)), depth: 300, tone: .46, rim: .8, rimW: 14, mist: .7, seed: 7 }), 0, 0);
+    A.cw.drawImage(mountainLayer({ W: 1920, H: 1080, ridge: bank, xmask: x => Math.min(1, Math.max(0, (660 - x) / 180)), depth: 90, tone: .4, rim: .8, rimW: 10, mist: .3, seed: 11 }), 0, 0);
+    cun(L, { x0: 1180, x1: 1920, ridge: midR, tone: .34, cun: 1.4, moss: 1.1, seed: 7 });
+    cun(L, { x0: 0, x1: 600, ridge: bank, tone: .3, cun: .9, moss: 1, seed: 11, cunLen: .5 });
+    cliff(L, 1960, 800, 2.1, 3, -1);
+    pine(L, 1810, 804, 1.25, 5, 0, 0, -1);
+    hero(L, POSE.stand, { x: 1640, y: 800, s: 1.7, dir: -1, seed: 2, t: .4 });
+    ripple(L, 1380, 905, 60, .35, 1, .18, 2.2); ripple(L, 1300, 960, 110, .22, 2, .18, 2);
+    // Two far-off sail shapes (for scale)
+    draw(L, mk([[520, 700], [522, 684]], { w: 2, tone: .5, dry: .3, prof: 'tip', seed: 900 }));
+    draw(L, mk([[512, 701], [534, 701]], { w: 2.2, tone: .45, dry: .3, prof: 'lens', seed: 901 }));
+    subtitle(A, 'The river keeps no name.\nIt waits for no one.', 170, 860, 1);
+    comp(A, null, { bleed: 5, rim: 1.0 });
+  }
+  if (f === 'cut') {
+    // A smudge of distant mountains (extremely pale)
+    A.cw.drawImage(mountainLayer({ W: 1920, H: 1080, ridge: ridgeFn([[300, 160, 120], [620, 90, 140], [1700, 120, 150]], 820, 5, 20), depth: 160, tone: .1, rim: .5, mist: .8, seed: 5 }), 0, 0);
+    // Wave (split open): drawn into a temporary layer first, then pasted back as an upper and a lower half divided along the cut line
+    const W = tmp();
+    wave(W.ink, { x: 1240, y: 900, s: 1.0, rise: 1, curl: 1, t: 3.2, seed: 21 });
+    const box = [300, 120, 480];
+    const cx0 = 300 + 84 * 4.8, cy0 = 120 + 73 * 4.8, cx1 = 2200, cy1 = 640;
+    const lineY = x => x < cx0 ? cy0 : cy0 + (x - cx0) / (cx1 - cx0) * (cy1 - cy0);
+    const k = .8;   // progress after the split
+    for (const key of ['wet', 'dry']) {
+      const c = A.ink[key];
+      // Lower half
+      c.save(); c.beginPath(); c.moveTo(0, lineY(0) + 14); c.lineTo(1920, lineY(1920) + 14); c.lineTo(1920, 1080); c.lineTo(0, 1080); c.closePath(); c.clip();
+      c.drawImage(W[key], 0, 18 * k); c.restore();
+      // Upper half: slides apart along the cut and fades (turns into mist)
+      c.save(); c.beginPath(); c.moveTo(0, lineY(0) - 14); c.lineTo(1920, lineY(1920) - 14); c.lineTo(1920, 0); c.lineTo(0, 0); c.closePath(); c.clip();
+      c.globalAlpha = 1 - k * .5; c.drawImage(W[key], 90 * k, -80 * k); c.restore(); c.globalAlpha = 1;
+    }
+    // First three strokes of the character 水 + the cutting-the-current feibai (飞白, dry-brush streaks)
+    const S = shuiStrokes(box, { dry: .26, w: 11 });
+    for (let i = 0; i < 3; i++) draw(L, S[i], 1);
+    draw(L, cutStroke(box, cx1, cy1, { w: 16, dry: .6 }), 1);
+    // Ink spots burst out
+    const R = mulberry(9);
+    for (let i = 0; i < 90; i++) {
+      const u = R(), x = cx0 + u * (1920 - cx0), y = lineY(x);
+      const a = (R() - .5) * 2.6, d = (20 + R() * 180) * (.4 + k);
+      const px = x + Math.cos(a) * d * .5 + d * .3, py = y + Math.sin(a) * d;
+      blot(A.cw, px, py, 2 + R() * 9 * (1 - u * .5), .85, R() * 3, .5 + R() * .5, i);
+      if (R() < .3) draw(L, mk([[px, py], [px - Math.cos(a) * 18, py - Math.sin(a) * 18]], { w: 3, tone: .8, dry: .4, prof: 'tip', seed: 1000 + i }));
+    }
+    // Swordsman (over-the-shoulder, from behind, sword swung out level with the motion)
+    hero(L, { ...POSE.backWrite, aR: [[8.5, -74], [22, -74], [36, -72]], sword: { a: .12 }, rib: [-1, -.1, 30] }, { x: 330, y: 1330, s: 6.4, seed: 8, t: 1.2 });
+    comp(A, null, { bleed: 5, rim: 1.0, shake: [3, -2] });
+  }
+}
diff --git a/.agents/skills/lemo/library/styles/ink-wash/demo/glyph.js b/.agents/skills/lemo/library/styles/ink-wash/demo/glyph.js
new file mode 100644
index 0000000..80fe39c
--- /dev/null
+++ b/.agents/skills/lemo/library/styles/ink-wash/demo/glyph.js
@@ -0,0 +1,72 @@
+// The character "水" (water): its skeleton is the glyph of the OFL kaishu (楷书, regular script) font Ma Shan Zheng.
+// The centrelines of the four strokes (vertical hook, horizontal-then-left-falling, left-falling, right-falling press) are traced from the glyph, with brush pressure matching the glyph's stroke thickness; the brush engine writes them one by one in stroke order, and the result is finally clipped by the glyph outline (slightly expanded),
+// so stroke order, lift-and-press and feibai (飞白, dry-brush streaks) come from the engine, while the character's structure and centre of gravity come from the calligraphic glyph. Coordinates are in a 100×100 character cell; the third number is brush pressure.
+import { mk, draw, TONE } from './ink.js';
+import { lerp, clamp } from '/core/lib.js';
+
+export const SHUI = [
+  // Vertical hook: start with a concealed tip (藏锋), lift slightly in the middle, gather force at the bottom, then flick the hook out to the upper left
+  [[42.5, 7.5, .7], [44.5, 9.5, 1.1], [44.8, 18, .95], [45, 38, .9], [45.3, 58, .92], [45.4, 76, 1.0], [44, 87, 1.12], [40.5, 90.5, 1.0], [35, 84, .7], [29, 76.5, .25]],
+  // Horizontal-then-left-falling: cut in with the brush, a short horizontal rising to the right, press and pause at the turn, then the left-falling stroke exits to the lower left with a sharp tip
+  [[12, 53, .6], [16, 49, .9], [24, 45.5, .85], [32, 42.5, .95], [37.5, 42.5, 1.15], [37.5, 49, 1.05], [33, 60, .95], [26, 70, .8], [17, 80, .55], [8, 87.5, .18]],
+  // Left-falling: start at upper right, go to lower left
+  [[74.5, 26.5, .8], [74, 31, 1.05], [68, 38, .9], [60, 44.5, .72], [53.5, 48.5, .5]],
+  // Right-falling press (捺): start light, grow heavy, the press foot exits flat
+  [[53, 48, .45], [58, 55, .62], [66, 63, .82], [74.5, 69.5, 1.0], [83, 74.5, 1.22], [90, 77, 1.05], [95.5, 77.5, .3]],
+];
+const WID = [8.2, 8.4, 8.5, 11];       // base width of each stroke (character-cell units)
+
+// Glyph mask (aligned with box)
+const maskCache = {};
+export function glyphMask(box, W = 1920, H = 1080) {
+  const key = box.join(',');
+  if (maskCache[key]) return maskCache[key];
+  const [x0, y0, S] = box, cv = document.createElement('canvas'); cv.width = W; cv.height = H;
+  const c = cv.getContext('2d');
+  c.font = `${S}px MaShanZheng`; c.textAlign = 'center'; c.textBaseline = 'alphabetic';
+  const m = c.measureText('水'), y = y0 + S / 2 + (m.actualBoundingBoxAscent - m.actualBoundingBoxDescent) / 2;
+  c.fillStyle = '#000'; c.fillText('水', x0 + S / 2, y);
+  c.strokeStyle = '#000'; c.lineWidth = S * .014; c.lineJoin = 'round'; c.strokeText('水', x0 + S / 2, y);   // slightly expanded, leaves a little room for the feibai's ragged edges
+  return (maskCache[key] = cv);
+}
+
+export function shuiStrokes(box, o = {}) {
+  const [x0, y0, sz] = box, k = sz / 100;
+  return SHUI.map((st, i) => mk(st.map(p => [x0 + p[0] * k, y0 + p[1] * k, p[2]]), {
+    w: WID[i] * k * (o.wk ?? 1.12), tone: TONE.jiao, dry: o.dry ?? .17, wet: o.wet ?? .35, prof: 'even', rough: .06, nb: 48, solid: true, seed: (o.seed ?? 51) * 10 + i,
+  }));
+}
+
+// Cutting the current: the character leaves along the press stroke's momentum, flattens and sweeps right out of frame (feibai)
+export function cutStroke(box, x1, y1, o = {}) {
+  const [x0, y0, sz] = box, k = sz / 100;
+  const P = [[62, 59, .45], [70, 66.5, .7], [79, 72.5, .92], [88, 76.5, 1.02]].map(p => [x0 + p[0] * k, y0 + p[1] * k, p[2]]);
+  const last = P[P.length - 1];
+  const n = 7;
+  for (let i = 1; i <= n; i++) {
+    const u = i / n;
+    P.push([lerp(last[0], x1, u), lerp(last[1], y1, Math.pow(u, .55)) + Math.sin(u * 3.1) * 5 * k, 1.05 + .15 * Math.sin(u * 2.2) - .4 * Math.pow(u, 3)]);
+  }
+  return mk(P, { w: (o.w ?? 13) * k, tone: TONE.jiao, dry: o.dry ?? .62, wet: .15, prof: 'even', rough: .16, nb: 64, solid: true, seed: o.seed ?? 777 });
+}
+
+// Write the character by progress: prog[i] ∈ [0,1] is how far stroke i has been written; T is the temporary layer {wet, dry, col contexts + canvases}; when written, clip with the glyph outline and paste onto the target layer
+export function writeShui(dst, T, box, prog, o = {}) {
+  const S = o.strokes || shuiStrokes(box, o);
+  for (const c of [T.ink.wet, T.ink.dry]) { c.setTransform(1, 0, 0, 1, 0, 0); c.globalCompositeOperation = 'source-over'; c.globalAlpha = 1; c.clearRect(0, 0, T.wet.width, T.wet.height); }
+  let any = false;
+  S.forEach((s, i) => { if ((prog[i] ?? 0) > 0) { draw(T.ink, s, prog[i], o.am ?? 1); any = true; } });
+  if (!any) return S;
+  const mask = glyphMask(box, T.wet.width, T.wet.height);
+  for (const key of ['wet', 'dry']) {
+    const c = T.ink[key]; c.globalCompositeOperation = 'destination-in'; c.drawImage(mask, 0, 0); c.globalCompositeOperation = 'source-over';
+    const d = dst[key]; d.save(); d.setTransform(1, 0, 0, 1, 0, 0); if (o.dx || o.dy || o.alpha != null) { d.globalAlpha = o.alpha ?? 1; } d.drawImage(T[key], o.dx || 0, o.dy || 0); d.restore();
+  }
+  return S;
+}
+
+// Sword-tip position: where the brush tip is when stroke i has been written to p (used to aim the swordsman's arm)
+export function tipAt(S, i, p) {
+  const s = S[i], m = (s.n - 1) * clamp(p), k = Math.floor(m), f = m - k, a = s.P[k], b = s.P[Math.min(s.n - 1, k + 1)];
+  return [lerp(a[0], b[0], f), lerp(a[1], b[1], f)];
+}
diff --git a/.agents/skills/lemo/library/styles/ink-wash/demo/hero.js b/.agents/skills/lemo/library/styles/ink-wash/demo/hero.js
new file mode 100644
index 0000000..2a26b67
--- /dev/null
+++ b/.agents/skills/lemo/library/styles/ink-wash/demo/hero.js
@@ -0,0 +1,321 @@
+// The nameless swordsman: xieyi (写意, freehand "write the idea") figure, formed in a few strokes. Pose = joint dictionary (local coords, height 100, y positive downward, origin at the soles, facing right).
+// Strokes are regenerated from the pose every frame (fixed seed → stable bristle texture); mirrored when facing left.
