+    shape(ctx, rect(-28, 44, 14, 26), { fill: PAL.chrome, line: 3, seed: 7 }); shape(ctx, rect(14, 44, 14, 26), { fill: PAL.chrome, line: 3, seed: 8 });
+    ink(ctx, spline([[64, 50], [86, 58], [92, 84]], false, 6), 5, { seed: 9 });
