+    g.fillStyle = 'rgba(247,241,230,.9)'; g.beginPath(); g.roundRect(W / 2 - w / 2 - 20, 1008 - 30, w + 40, 52, 4); g.fill();
+    g.fillStyle = C.ink; g.textAlign = 'center'; g.textBaseline = 'middle'; g.fillText(s.text, W / 2, 1008 - 3); g.restore();
+  }
+}
