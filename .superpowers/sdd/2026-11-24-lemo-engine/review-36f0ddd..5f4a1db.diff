+            "duration_seconds": 6,
+            "aspect": "16:9",
+        }
+    )
+    assert r.success, r.error
+    clip = tmp_path / "demo/lemo/clips/clip-01"
+    tokens = [
+        "__CLIP_ID__",
+        "__STYLE_ID__",
+        "__SUBJECT__",
+        "__ONE_IDEA__",
+        "__ASPECT__",
+        "__WIDTH__",
+        "__HEIGHT__",
+        "__FPS__",
+        "__DURATION__",
+        "__SOUND__",
+        "__TEXT_MODE__",
