{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/style_lock",
  "title": "Style Lock",
  "description": "Style identity for a faceless-short or editor-pipeline project, written at the idea stage after reading the style contract (STYLE.md / style.md + base.js) and inspecting the referenced material. The referenced document remains binding; this artifact is an auditable snapshot, not a replacement for the document.",
  "type": "object",
  "required": ["version", "style_id", "style_name", "engine", "contract", "source", "format", "confirmed_by_user", "resolution_note"],
  "allOf": [
    {
      "if": { "properties": { "engine": { "const": "canvas-2d" } }, "required": ["engine"] },
      "then": { "required": ["palette", "caption_rules"] }
    },
    {
      "if": { "properties": { "engine": { "const": "threejs" } }, "required": ["engine"] },
      "then": { "required": ["palette", "caption_rules"] }
    }
  ],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "style_id": {
      "type": "string",
      "enum": [
        "deep-dive",
        "night-file",
        "inside-out",
        "stick-story",
        "paper-atlas",
        "tall-tale",
        "chalk-talk",
        "clean-tech",
        "creator-motion-graphics",
        "data-story",
        "pop-info",
        "software-walkthrough",
        "warm-canvas"
      ]
    },
    "style_name": { "type": "string", "minLength": 1 },
    "engine": { "type": "string", "enum": ["canvas-2d", "threejs", "editor-canvas"] },
    "contract": {
      "type": "string",
      "minLength": 1,
      "description": "One-line playback of the style the user will see, e.g. 'Inside Out: flat 2D x-ray what-if explainer, 9:16, 25-45 s, 1-3 word captions with one yellow word.'"
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": ["style_md", "engine_js", "has_aroll"],
          "properties": {
            "style_md": {
              "type": "string",
              "pattern": "^\\.agents/skills/ai-video-editor/styles/[a-z0-9-]+/style\\.md$"
            },
            "engine_js": {
              "type": "string",
              "pattern": "^\\.agents/skills/ai-video-editor/styles/[a-z0-9-]+/base\\.js$"
            },
            "has_aroll": {
              "type": "boolean",
              "description": "True when the style keeps the speaker on screen (A-roll), false when it replaces the footage with full-screen graphics."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["style_md", "style_sheet", "example"],
          "properties": {
            "style_md": {
              "type": "string",
              "pattern": "^\\.agents/skills/faceless-shorts/styles/[a-z0-9-]+/STYLE\\.md$"
            },
            "style_sheet": {
              "type": "string",
              "pattern": "^\\.agents/skills/faceless-shorts/styles/[a-z0-9-]+/style-sheet\\.png$"
            },
            "example": {
              "type": "string",
              "pattern": "^\\.agents/skills/faceless-shorts/styles/[a-z0-9-]+/example$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "format": {
      "type": "object",
      "required": ["aspect", "resolution", "fps", "duration_seconds"],
      "properties": {
        "aspect": {
          "enum": ["9:16", "16:9", "3:4"],
          "description": "Output aspect ratio. Faceless styles are locked to 9:16; editor styles accept the user's chosen ratio."
        },
        "resolution": { "type": "string", "pattern": "^\\d+x\\d+$" },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "description": "Delivery frame rate. Equal to the style's native fps unless fps_native_fps is set, which records the style's own rate alongside a sanctioned override."
        },
        "fps_native": {
          "type": "integer",
          "minimum": 1,
          "description": "The style's native frame rate. Required when fps differs from it, so an override is always explicit and never silently mistaken for the style's own rate."
        },
        "fps_override_reason": {
          "type": "string",
          "minLength": 1,
          "description": "Why the delivery rate differs from the style's native rate. Required when fps != fps_native."
        },
        "duration_seconds": {
          "type": "array",
          "items": { "type": "number", "minimum": 1 },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "palette": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
    },
    "caption_rules": {
      "type": "object",
      "required": ["words_per_chunk", "yellow_words_per_chunk", "font"],
      "properties": {
        "words_per_chunk": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 2,
          "maxItems": 2
        },
        "yellow_words_per_chunk": { "type": "integer", "minimum": 0 },
        "zone_y": {
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 2,
          "maxItems": 2
        },
        "font": { "type": "string", "minLength": 1 },
        "outline": { "type": "string" }
      },
      "additionalProperties": true
    },
    "confirmed_by_user": {
      "type": "boolean",
      "description": "False on the first awaiting_human checkpoint; true only after the user approves the style at the idea gate."
    },
    "resolution_note": {
      "type": "string",
      "minLength": 1,
      "description": "Why this style was selected: exact canonical-name match, alias match, or explicit user choice."
    },
    "language_support": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Languages the chosen style supports (editor styles: en/bn)."
    },
    "example_evidence": {
      "type": "object",
      "required": ["name", "shot_count"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "shot_count": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
